# DATABASE
# Gere uma URL PostgreSQL em:
# - https://console.neon.tech/ (Neon - Free tier)
# - https://supabase.com/dashboard/projects (Supabase)
# Formato: postgresql://user:password@host:5432/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/gestor_de_riscos?schema=public"

# NEXT-AUTH
# Gere um secret forte com: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-secret-generated-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Senha compartilhada de login do gestor/admin (qualquer e-mail cadastrado no
# banco usa essa mesma senha). Defina um valor forte e privado — sem essa
# variável configurada, o login fica bloqueado.
AUTH_SHARED_PASSWORD="replace-with-a-strong-private-password"

# CLOUDINARY
# Crie uma conta em: https://cloudinary.com/console
# Encontre as credenciais em: Settings > API Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# RESEND (Email notifications)
# Crie uma conta em: https://resend.com
# Encontre a API key em: Settings > API Keys
RESEND_API_KEY="re_your-api-key-here"

# SEGURANÇA (Fase 5)
# Origens permitidas para CORS (separadas por vírgula). Em produção use seu domínio Vercel.
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# NODE ENV (deixe como production no Vercel)
NODE_ENV="development"

# Em Windows sem toolchain de build nativo, evita erro "bufferUtil.mask is
# not a function" na conexão WebSocket com o Neon (usada por @neondatabase/serverless).
WS_NO_BUFFER_UTIL="1"
